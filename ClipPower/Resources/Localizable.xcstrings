      }
    },
    "选择文件并导入..." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose File and Import..." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイルを選んでインポート..." } }
      }
    },
    "与 Raycast 互通" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Raycast Interoperability" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Raycast との連携" } }
      }
    },
    "Raycast 官方 Snippets JSON 格式为 [{ name, text, keyword }]，没有可见性/加密概念。导入时全部落库为公开可见性；导出时只包含公开（未隐藏）片段——软隐藏/加密隐藏的内容不会被导出成这种没有任何保护的明文格式。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Raycast's official Snippets JSON format is [{ name, text, keyword }], with no concept of visibility or encryption. Importing saves everything as public; exporting includes only public (non-hidden) snippets — soft-hidden and encrypted-hidden content is never exported into this unprotected plain-text format." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Raycast公式のSnippets JSON形式は [{ name, text, keyword }] で、表示設定や暗号化の概念がありません。インポート時はすべて公開として保存され、エクスポート時は公開（非表示でない）スニペットのみが含まれます。ソフト非表示・暗号化非表示の内容は、保護のないこの平文形式で書き出されることはありません。" } }
      }
    },
    "选择 Raycast Snippets 文件导入..." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a Raycast Snippets File to Import..." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Raycast Snippetsファイルを選んでインポート..." } }
      }
    },
    "导出为 Raycast 格式..." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Export as Raycast Format..." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Raycast形式でエクスポート..." } }
      }
